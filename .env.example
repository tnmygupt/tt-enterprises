# ——— Hostinger MySQL (shared books) ———
# Node on Hostinger: MYSQL_HOST=localhost
# Laptop / migrate script: MYSQL_HOST=srv1949.hstgr.io (remote access on)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=u415877111_tterp
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=u415877111_tterp
NEXT_PUBLIC_CLOUD_DB=1

# Browser /api/db key (optional if staff use login cookies)
DB_API_KEY=long-random-secret
NEXT_PUBLIC_DB_API_KEY=long-random-secret
TT_APP_DB_GATE=different-server-only-gate-secret
SESSION_SECRET=different-long-random-secret
#
# DB_API_KEY and NEXT_PUBLIC_DB_API_KEY must be identical (browser x-tt-db-key).
# SESSION_SECRET must differ — used only for httpOnly cookie HMAC (never public).
# Local/prod build also reads .env.production when present (gitignored).

# ——— Firebase (optional alternative shared DB + Storage) ———
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# ——— Web Push (PWA notifications) ———
# Generate keys: npx web-push generate-vapid-keys
# Put the public key in NEXT_PUBLIC_VAPID_PUBLIC_KEY and private in VAPID_PRIVATE_KEY.
# VAPID_SUBJECT must be a mailto: or https: URL you control.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ttenterprises.shop

# ——— WhatsApp (silent send) ———
# Preferred: TallyWebSolutions QR instance.
# Login: https://app.tallywebsolutions.in/  — never commit the real key.
TALLY_WA_INSTANCE_KEY=YOUR_INSTANCE_KEY
# TALLY_WA_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
# TALLY_WA_BASE_URL=https://app.tallywebsolutions.in
#
# Fallback: Meta Cloud API (only used when TALLY_WA_INSTANCE_KEY is unset)
WHATSAPP_TOKEN=YOUR_PERMANENT_OR_TEMP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# WHATSAPP_API_VERSION=v21.0
# Optional extra header for cron/scripts (staff session cookie is enough in the browser):
# WHATSAPP_SEND_KEY=required-in-production
#
# Incoming chats (team inbox). Paste this on the Tally WhatsApp portal:
# https://tanmayphotos.space/api/whatsapp/webhook?secret=YOUR_SECRET
# WA_WEBHOOK_SECRET must match that secret. If unset, the instance key in the URL still works.
# WA_WEBHOOK_SECRET=long-random-webhook-secret

# ——— Cron (auto reorder + WhatsApp digest) ———
# POST/GET /api/cron/reorder and /api/cron/whatsapp-digest
# Authorization: Bearer <secret>  or  ?secret=<secret>
CRON_SECRET=long-random-cron-secret

# ——— Uploads ———
# Required in production: clients must send header x-upload-key
UPLOAD_KEY=long-random-upload-secret

# ——— Translate ———
# TRANSLATE_KEY=
