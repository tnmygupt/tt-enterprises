# ——— Supabase (shared DB — preferred) ———
# Hostinger injects SUPABASE_URL + SUPABASE_API_KEY (often the anon key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
#
# Recommended on Hostinger (hPanel → Deployments → Settings & Redeploy → Environment):
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DB_API_KEY=long-random-secret
NEXT_PUBLIC_DB_API_KEY=long-random-secret
TT_APP_DB_GATE=different-server-only-gate-secret
SESSION_SECRET=different-long-random-secret
#
# DB_API_KEY and NEXT_PUBLIC_DB_API_KEY must be identical (browser x-tt-db-key).
# TT_APP_DB_GATE must differ — used only for legacy Supabase RPCs (prefer service role).
# SESSION_SECRET must differ — used only for httpOnly cookie HMAC (never public).
# Local/prod build also reads .env.production when present (gitignored).
#
# SUPABASE_API_KEY=…   # Hostinger default; keep as anon fallback
#
# RLS: supabase/secure-rls.sql (already applied on the live project).

# ——— Firebase (optional alternative shared DB + Storage) ———
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# ——— Web Push (PWA notifications) ———
# Generate keys: npx web-push generate-vapid-keys
# Put the public key in NEXT_PUBLIC_VAPID_PUBLIC_KEY and private in VAPID_PRIVATE_KEY.
# VAPID_SUBJECT must be a mailto: or https: URL you control.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ttenterprises.shop

# ——— WhatsApp Cloud API (Meta) ———
WHATSAPP_TOKEN=YOUR_PERMANENT_OR_TEMP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_SEND_KEY=required-in-production

# ——— TallyPrime bridge (hybrid books: Tally = legal books; site = ops + stock mirror) ———
# Bridge (office PC) POSTs stock to /api/tally/sync with x-tally-sync-key.
# Required in production (no default secret). Keep private — never NEXT_PUBLIC.
TALLY_SYNC_KEY=tt-enterprises-tally-change-me
# Read key for GET /api/tally/latest (staff browsers auto-apply stock).
# Must match NEXT_PUBLIC_TALLY_READ_KEY. Must differ from TALLY_SYNC_KEY.
TALLY_READ_KEY=tt-enterprises-tally-read-change-me
NEXT_PUBLIC_TALLY_READ_KEY=tt-enterprises-tally-read-change-me
# Set to 1 so staff browsers pull /api/tally/latest about every 60s.
NEXT_PUBLIC_TALLY_AUTOSYNC=1
# Live bridge:
# SYNC_URL=https://tanmayphotos.space/api/tally/sync
# POSTS_URL=https://tanmayphotos.space/api/tally/posts

# ——— Cron (auto reorder draft POs) ———
# POST/GET /api/cron/reorder with Authorization: Bearer <secret>
# Or ?secret=<secret> for simple Hostinger curl cron jobs.
CRON_SECRET=long-random-cron-secret

# ——— Uploads ———
# Required in production: clients must send header x-upload-key
UPLOAD_KEY=long-random-upload-secret

# ——— Translate ———
# TRANSLATE_KEY=
