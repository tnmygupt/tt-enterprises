# TallyPrime company name (exact as in Tally)
TALLY_COMPANY=TT Enterprises

# Tally HTTP server (enable in TallyPrime > F1 > Connectivity)
TALLY_HOST=http://localhost:9000

# Website API (stock in). Pending sales and ack use the same host.
SYNC_URL=https://app.ttenterprises.shop/api/tally/sync
TALLY_SYNC_KEY=tt-enterprises-tally-dev-key

# Optional map when the website SKU / name is not the Tally item name.
# Format: TALLY_ITEM_NAME=productId:variationId
# MAP_TRP-HDPE-120-12x18=prod_tarpaulin_hdpe:var_trp_12x18

# Poll interval seconds (when not using --once)
POLL_SECONDS=300
