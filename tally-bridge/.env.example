# TallyPrime company name (exact as in Tally)
TALLY_COMPANY=TT Enterprises

# Tally HTTP server (enable in TallyPrime > F1 > Connectivity)
TALLY_HOST=http://localhost:9000

# Website APIs — production
SYNC_URL=https://tanmayphotos.space/api/tally/sync
POSTS_URL=https://tanmayphotos.space/api/tally/posts
# Local testing:
# SYNC_URL=http://localhost:3000/api/tally/sync
# POSTS_URL=http://localhost:3000/api/tally/posts

# Must match website TALLY_SYNC_KEY (server-only write key)
TALLY_SYNC_KEY=tt-enterprises-tally-change-me

# Simple non-GST voucher ledgers (must exist in Tally)
TALLY_SALES_LEDGER=Sales
TALLY_BANK_LEDGER=Bank
TALLY_PARTY_PARENT=Sundry Debtors

# Map Tally stock item name -> website product/variation
# Format: MAP_<TallyItemName>=productId:variationId
# MAP_TRP-HDPE-120-12x18=prod_tarpaulin_hdpe:var_trp_12x18
# MAP_SN-50-3M=prod_shade_net_50:var_sn_3m

# Poll interval seconds (when not using --once)
POLL_SECONDS=300
