# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# scratch output from scripts/check-*.mts
/tmp

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# media uploads (keep folders)
/public/uploads/**/*
!/public/uploads/**/.gitkeep

# server-side tally sync payload
/data/*
!/data/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug-*.log
tmp-translate-out.txt

# local deploy archives (never commit)
deploy-*.zip
deploy-*.tar.gz
tt-enterprises-*.zip

# env files (can opt-in for committing if needed)
.env*
!.env.example
!tally-bridge/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
